    "Para começarmos..." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To get started..."
          }
        },
        "ja" : {
          "stringUnit" : {
