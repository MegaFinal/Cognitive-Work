        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "こんにちは、%@だよ!Pipaをダウンロードしたよ。うちの家に参加したいから、招待リンクを送ってもらえる?🏠"
          }
        },
        "ko" : {
