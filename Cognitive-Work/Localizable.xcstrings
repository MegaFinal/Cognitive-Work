          }
        }
      }
    },
    "Você não tem permissão para fazer isso." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You don't have permission to do this."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
