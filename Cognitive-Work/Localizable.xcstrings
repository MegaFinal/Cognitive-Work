          "stringUnit" : {
            "state" : "translated",
            "value" : "기간 내 모든 날을 담당하게 돼요."
          }
        }
      }
    },
    "Você já tem um cupom desse cômodo neste ciclo." : {
      "extractionState" : "stale",
