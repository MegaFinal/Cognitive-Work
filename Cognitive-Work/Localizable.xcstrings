    "Conferir as datas de validade e separar o que vence logo." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check expiration dates and set aside what expires soon."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisar las fechas de vencimiento y separar lo que vence pronto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifier les dates de péremption et mettre de côté ce qui périme bientôt."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "賞味期限を確認し、もうすぐ切れる物を分けておきましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "유통기한을 확인하고 곧 만료되는 것을 따로 두세요."
          }
        }
      }
    },
    "Conferir o estoque, repor o que acabou e arrumar as prateleiras." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check stock, replace what ran out and tidy the shelves."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisar el inventario, reponer lo que se acabó y ordenar los estantes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifier le stock, remplacer ce qui manque et ranger les étagères."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在庫を確認し、なくなった物を補充して棚を整理しましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "재고를 확인하고 떨어진 것을 채우고 선반을 정리하세요."
          }
        }
      }
    },
    "Conferir papel higiênico, sabonete e shampoo e repor o que faltar." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check toilet paper, soap and shampoo and replace what's missing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisar papel higiénico, jabón y champú y reponer lo que falte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifier le papier toilette, le savon et le shampoing et remplacer ce qui manque."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トイレットペーパー、石けん、シャンプーを確認し、足りない物を補充しましょう。"
