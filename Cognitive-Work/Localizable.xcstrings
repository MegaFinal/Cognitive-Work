            "value" : "This was changed on another device. Refresh and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto se cambió en otro dispositivo. Actualiza la pantalla e inténtalo de nuevo."
