    },
    "Clique no botão abaixo para dividir as tarefas entre todos os moradores da casa automaticamente" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap the button below to automatically split the chores among everyone in the home"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca el botón de abajo para repartir las tareas automáticamente entre todos los integrantes de la casa"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
