            "value" : "이번 사이클에 이미 이 공간의 쿠폰을 가지고 있어요."
          }
        }
      }
    },
    "Você mandou muito bem!" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
