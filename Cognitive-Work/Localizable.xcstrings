    "Conferir as datas de validade e separar o que vence logo." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check expiration dates and set aside what expires soon."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "賞味期限を確認し、もうすぐ切れる物を分けておきましょう。"
