    "As %lld tarefas deste cômodo também serão excluídas. Esta ação não pode ser desfeita." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This room's %lld chores will also be deleted. This can't be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las %lld tareas de este ambiente también se eliminarán. Esta acción no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les %lld tâches de cette pièce seront aussi supprimées. Cette action est irréversible."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この部屋の家事%lld件も一緒に削除されます。この操作は取り消せません。"
