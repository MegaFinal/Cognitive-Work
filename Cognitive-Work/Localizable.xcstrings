    "A casa cresceu: peça para %@ atualizar o plano." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your home grew: ask %@ to upgrade the plan."
          }
        }
      }
    },
    "A casa criada será apagada e os roomies que já entraram perderão o acesso." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The home you created will be deleted and any roomies who already joined will lose access."
          }
        }
      }
    },
    "A casa já foi criada por outro morador" : {
      "localizations" : {
