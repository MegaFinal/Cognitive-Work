          }
        }
      }
    },
    "As tarefas que sobraram da divisão ficam na tela inicial, no botão %@. Pegue as que couberem no seu tempo." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
