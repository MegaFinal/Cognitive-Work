        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "유통기한을 확인하고 곧 만료되는 것을 따로 두세요."
          }
        }
      }
    },
    "Conferir o estoque, repor o que acabou e arrumar as prateleiras." : {
      "extractionState" : "stale",
