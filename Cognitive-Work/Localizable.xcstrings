    "O trabalho de notar, lembrar e distribuir tarefas também faz parte da organização da casa" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The work of noticing, remembering and assigning chores is also part of running the home"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El trabajo de notar, recordar y repartir tareas también es parte de organizar la casa"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remarquer, se souvenir et répartir les tâches fait aussi partie de l’organisation de la maison"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "家事に気づき、思い出し、割り振る仕事も、家を運営する仕事の一部です"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "집안일을 알아채고, 기억하고, 나누는 일도 집을 운영하는 일의 일부예요"
          }
        }
      }
    },
    "O trabalho de notar, lembrar, decidir e acompanhar é tão importante quanto realizar uma tarefa" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The work of noticing, remembering, deciding and following up matters as much as doing a chore"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El trabajo de notar, recordar, decidir y dar seguimiento es tan importante como hacer una tarea"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remarquer, se souvenir, décider et suivre compte autant que faire une tâche"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "気づき、思い出し、決め、フォローする仕事は、家事をすることと同じくらい大切です"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "알아채고, 기억하고, 결정하고, 챙기는 일은 집안일을 직접 하는 것만큼 중요해요"
          }
        }
      }
    },
