      }
    },
    "você consegue!" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "you've got this!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
