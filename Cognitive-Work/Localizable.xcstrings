      }
    },
    "Isso marca que a pessoa já te pagou. Não dá para desfazer." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This marks that they've already paid you. This can't be undone."
          }
        },
