        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salut, c’est %@ ! J’ai téléchargé Pipa et je veux rejoindre notre maison. Tu peux m’envoyer le lien d’invitation ? 🏠"
          }
