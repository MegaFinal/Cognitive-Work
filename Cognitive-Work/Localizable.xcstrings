    "Ex.:\n2kg de arroz, R$ 25, eu e Ana\ndetergente para todos\n1 L de leite" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E.g.:\n2 kg of rice, R$ 25, me and Ana\ndish soap for everyone\n1 L of milk"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ej.:\n2 kg de arroz, R$ 25, yo y Ana\ndetergente para todos\n1 L de leche"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ex. :\n2 kg de riz, 25 R$, moi et Ana\nliquide vaisselle pour tous\n1 L de lait"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "例:\n米2kg、R$ 25、私とAna\nみんな用の食器用洗剤\n牛乳1L"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "예:\n쌀 2kg, R$ 25, 나와 Ana\n모두를 위한 주방세제\n우유 1L"
          }
        }
      }
    },
    "Ex.:\n2kg de arroz, R$ 25, eu e Ana\ndetergente para todos\nquero fazer lasanha" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
