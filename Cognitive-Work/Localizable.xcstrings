    "Passar as peças que precisam e deixá-las prontas para guardar." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iron the pieces that need it and get them ready to put away."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planchar las prendas que lo necesiten y dejarlas listas para guardar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repasser les vêtements qui en ont besoin et les préparer à être rangés."
          }
        }
      }
    },
    "Passar pano de microfibra na tela e tirar a poeira entre as teclas." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wipe the screen with a microfiber cloth and dust between the keys."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasar un paño de microfibra por la pantalla y quitar el polvo entre las teclas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passer un chiffon microfibre sur l’écran et dépoussiérer entre les touches."
          }
        }
      }
    },
    "Passar pano de microfibra na tela, no rack e nos controles." : {
      "extractionState" : "manual",
