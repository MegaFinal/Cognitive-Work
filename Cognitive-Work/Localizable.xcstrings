    "O armazenamento do iCloud do usuário está cheio. Libere espaço para continuar." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your iCloud storage is full. Free up space to continue."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El almacenamiento de iCloud está lleno. Libera espacio para continuar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton stockage iCloud est plein. Libère de l’espace pour continuer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ユーザーのiCloudストレージがいっぱいです。続けるには空き容量を確保してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용자의 iCloud 저장 공간이 가득 찼어요. 계속하려면 공간을 확보하세요."
          }
        }
      }
    },
    "O armazenamento do iCloud está cheio. Libere espaço para continuar." : {
      "localizations" : {
