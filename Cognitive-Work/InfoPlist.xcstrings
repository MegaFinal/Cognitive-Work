    "NSLocalNetworkUsageDescription" : {
      "comment" : "Privacy - Local Network Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "We use the local network to find and communicate with Harvii."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usamos la red local para encontrar y comunicarnos con Harvii."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous utilisons le réseau local pour trouver Harvii et communiquer avec lui."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Usamos a rede local para encontrar e se comunicar com o Harvi."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - Microphone Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We use the microphone so you can add items by speaking."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usamos el micrófono para que puedas agregar ítems hablando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous utilisons le micro pour que tu puisses ajouter des articles à la voix."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Usamos o microfone para você adicionar itens falando."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "comment" : "Privacy - Speech Recognition Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We use speech recognition to turn what you say into list items."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usamos el reconocimiento de voz para convertir lo que dices en ítems de la lista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous utilisons la reconnaissance vocale pour transformer ce que tu dis en articles de la liste."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Usamos o reconhecimento de fala para transformar o que você diz em itens da lista."
          }
        }
      }
    }
