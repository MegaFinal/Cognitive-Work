    "NSCalendarsFullAccessUsageDescription" : {
      "comment" : "Privacy - Calendars Full Access Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We need access to your calendar to sync and update the household chores assigned to you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Necesitamos acceso a tu calendario para sincronizar y actualizar las tareas domésticas que te asignaron."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous avons besoin d’accéder à ton calendrier pour synchroniser et mettre à jour les tâches ménagères qui te sont attribuées."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Precisamos de acesso ao seu calendário para sincronizar e atualizar as suas tarefas domésticas atribuídas."
          }
        }
      }
    },
    "NSHumanReadableCopyright" : {
